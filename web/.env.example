# ---------------------------------------------------------------------------
# Promo-exchange configuration
# Copy this file to `.env` and fill in real values. Never commit the real .env.
# ---------------------------------------------------------------------------

# ---- Server ----
PORT=3000

# ---- Branding (all shown in the UI) ----
COIN_NAME=YourCoin
COIN_TICKER=YCN
COIN_LOGO_URL=/logo.svg
ACCENT_COLOR=#00c2ff
ACCENT_COLOR_2=#7b5bff

# ---- Exchange pair ----
# How many USDT you pay out for 1 unit of the token at the base rate.
# Example: BASE_RATE_USDT_PER_COIN=0.00042
BASE_RATE_USDT_PER_COIN=0.0001

# Minimum / maximum amount of the incoming coin per order.
MIN_COIN_AMOUNT=100
MAX_COIN_AMOUNT=1000000

# ---- Promo bonus tiers (%) ----
# Comma-separated bonus percentages applied by transaction index
# (1st exchange, 2nd exchange, 3rd exchange, ...).
# You can add as many tiers as you want. After the list ends,
# BONUS_DEFAULT_PCT is used.
# Example: BONUS_TIERS_PCT=2.5,1.75,3.65   →  1st +2.5 %, 2nd +1.75 %, 3rd +3.65 %
BONUS_TIERS_PCT=2.5,1.75,3.65
BONUS_DEFAULT_PCT=0

# Optional: time-limited promo banner (minutes). Set to 0 to disable.
PROMO_DURATION_MINUTES=5
PROMO_HEADLINE=Limited 5-minute boost
PROMO_SUBTEXT=Better rates on your first exchanges

# ---- Deposit address shown to the user ----
# The user sends the coin to this address. Plug in your own receiving wallet.
DEPOSIT_ADDRESS_COIN=EQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEPOSIT_NETWORK=TON

# ---- Social / community links (shown in the footer) ----
SOCIAL_TELEGRAM=https://t.me/your_channel
SOCIAL_TWITTER=https://x.com/your_handle
SOCIAL_WEBSITE=https://example.com
SOCIAL_DEXSCREENER=
SOCIAL_GECKOTERMINAL=
SOCIAL_GITHUB=
